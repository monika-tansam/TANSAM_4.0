# Copy to an operator-only file; never commit credentials.
# Use --profile local-llm for Compose-managed CPU Ollama, or set private endpoints.
TANSY_OLLAMA_URL=http://ollama:11434
TANSY_CHAT_OLLAMA_URL=http://ollama:11434
TANSY_MODEL=nomic-embed-text:latest
TANSY_KNOWLEDGE_DIR=./knowledge
TANSY_BACKUP_DIR=./backups
TANSY_LLM_MEMORY=8g
TANSY_LLM_CPUS=4.0
TANSY_CHROMA_TOKEN=
TANSY_OLLAMA_TOKEN=
